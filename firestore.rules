rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Buraya gerçek admin e-postalarını yazın.
    // Firebase Console > Authentication'dan self-signup'ı da KAPATIN.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'admin@cugatcafe.com'
        ];
    }

    // Menü öğeleri — herkes okur, sadece admin yazar
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kategoriler
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // İşletme bilgileri
    match /businessInfo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diller
    match /languages/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Yorumlar
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
